# СПбМТСБ. Пустой список получателей использует RECIPIENTS.
SPIMEX_SUCCESS_RECIPIENTS=
SPIMEX_ERROR_RECIPIENTS=
SPIMEX_URL=https://spimex.com/markets/oil_products/instruments/list/service.php?code=PCX1UGU036F&rand=960&pageId=1e7e0c0&token=___
SPIMEX_LAST_ROWS=30
SPIMEX_OUTPUT_DIR=output/spimex
SPIMEX_CSV_FILENAME=spimex_latest.csv
SPIMEX_TIMEZONE=Europe/Moscow
# auto: UTF-8/UTF-16 BOM/Windows-1251. При необходимости задайте cp1251.
SPIMEX_SOURCE_ENCODING=auto
# auto, tab или символ-разделитель. service.php распознаётся без заголовка.
SPIMEX_SOURCE_DELIMITER=auto
# Пусто — найти дату автоматически. Для service.php столбец даты называется date.
SPIMEX_DATE_COLUMN=
# Пусто — прямой доступ. Здесь можно указать HTTP/SOCKS-прокси.
SPIMEX_PROXY_URL=
SPIMEX_CONNECT_TIMEOUT=10
SPIMEX_READ_TIMEOUT=60
SPIMEX_HTTP_ATTEMPTS=3

# Среднесуточная температура Цхинвала. Отдельное ежедневное письмо.
TSKHINVAL_SUCCESS_RECIPIENTS=
TSKHINVAL_ERROR_RECIPIENTS=
TSKHINVAL_OUTPUT_DIR=output/tskhinval
TSKHINVAL_CSV_FILENAME=temperature_tskhinval.csv
TSKHINVAL_TIMEZONE=Europe/Moscow
# Завершённые сутки от D-15 по D-1.
TSKHINVAL_PAST_DAYS=15
# Горизонт по прежнему соглашению: сегодня и следующие 7 суток (8 строк).
TSKHINVAL_FORECAST_DAYS_AHEAD=7
# false — только завтра … D+7, всего 7 строк.
TSKHINVAL_INCLUDE_TODAY=true
TSKHINVAL_REGION_NAME=Цхинвал
TSKHINVAL_PARENT_NAME=Южная Осетия
TSKHINVAL_LATITUDE=42.22764
TSKHINVAL_LONGITUDE=43.96861
TSKHINVAL_ELEVATION_METRES=874
TSKHINVAL_MODEL=ecmwf_ifs
TSKHINVAL_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
TSKHINVAL_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# При наличии ключа стандартные URL автоматически переключаются на customer-*.
TSKHINVAL_API_KEY=
TSKHINVAL_PROXY_URL=
TSKHINVAL_CONNECT_TIMEOUT=10
TSKHINVAL_READ_TIMEOUT=60
TSKHINVAL_HTTP_ATTEMPTS=3
