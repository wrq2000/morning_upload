# Скопируйте необходимые новые строки в существующий .env сервера.
# Реквизиты прежних процессов и адреса получателей сохраните.

# Состав запускаемых задач задаётся только в main.py: ENABLED_PROCESSES.

RECIPIENTS=
ADMIN_RECIPIENTS=
EPIAS_LOGIN=
EPIAS_PASSWORD=
# Серверный отдельный список получателей EPİAŞ сохраняется.
EPIAS_RECIPIENTS=

# Основной почтовый сервис. Прежние SMTP_* полностью поддерживаются.
SMTP_SERVER=smtp.yandex.ru
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_TIMEOUT=30

# Резервный независимый сервис. Заполните второй аккаунт.
SMTP_BACKUP_SERVER=smtp.gmail.com
SMTP_BACKUP_PORT=465
SMTP_BACKUP_SECURITY=ssl
SMTP_BACKUP_EMAIL=
SMTP_BACKUP_PASSWORD=
SMTP_BACKUP_TIMEOUT=30

# БелАЭС: auto = напрямую, затем SSH/VPN при сетевой/HTTP-ошибке или странице блокировки.
# direct = только напрямую; vpn = только через SSH/VPN.
BELAES_NETWORK_MODE=auto
# Нужна страница производственных показателей, не главная страница.
BELAES_URL=https://belaes.by/ru/proizvodstvennye-pokazateli.html
BELAES_CONNECT_TIMEOUT=10
BELAES_READ_TIMEOUT=30
BELAES_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0"

# dynamic создаёт временный SOCKS5 поверх SSH. Отдельно запускать Hiddify не нужно.
# forward — при необходимости пробросить конкретный прокси-порт на VPN-сервере.
BELAES_TUNNEL_MODE=dynamic
# Пустые SSH-поля наследуют одноимённые UEEX_* из вашего существующего .env.
BELAES_SSH_HOST=
BELAES_SSH_USER=
BELAES_SSH_PORT=
# На ноутбуке можно задать ~/.ssh/id_ed25519; в Docker — /root/.ssh/<имя ключа>.
BELAES_SSH_KEY=
BELAES_SSH_KNOWN_HOSTS=
BELAES_SSH_HOST_KEY_SHA256=
BELAES_SSH_CONNECT_TIMEOUT=
BELAES_SSH_STARTUP_TIMEOUT=
# Порт используется только в forward; для dynamic оставьте 0.
BELAES_REMOTE_PROXY_PORT=0
BELAES_REMOTE_PROXY_SCHEME=socks5h

# УЭБ. Пустой список получателей использует общий RECIPIENTS.
UEEX_SUCCESS_RECIPIENTS=
UEEX_EMAIL_SUBJECT="УЭБ — экспорт природного газа — {date}"
UEEX_START_DATE=2026-10-15
UEEX_END_DATE=
UEEX_TIMEZONE=Europe/Moscow
UEEX_OUTPUT_DIR=output/ueex
# Окно календаря и результатов на каждом запуске, включая текущий день.
UEEX_RECHECK_DAYS=14
# Повторы только для JSON-ошибки Message в ответе HTTP 200.
UEEX_API_ERROR_ATTEMPTS=2
UEEX_API_ERROR_BACKOFF=5

# Обязательный маршрут УЭБ через VPN-прокси. Прямого fallback нет.
# UEEX_PROXY_URL используется только в режиме none.
# В dynamic/forward Paramiko подставляет адрес своего прокси внутри контейнера.
UEEX_PROXY_ENABLED=true
UEEX_PROXY_URL=socks5h://127.0.0.1:12334

# Остальные параметры — defaults.env в processes/ueex.
# Любой параметр можно переопределить здесь, добавив префикс UEEX_.

# Для SSH-доступа к VPN-серверу: Paramiko создаёт туннель внутри контейнера.
# none = использовать UEEX_PROXY_URL; dynamic = SOCKS5 через SSH-сервер;
# forward = проброс подтверждённого HTTP/SOCKS-порта с удалённого loopback.
UEEX_TUNNEL_MODE=dynamic
UEEX_SSH_HOST=185.28.175.2
UEEX_SSH_USER=root
# Пустой порт использует SSH config (либо стандартный 22).
UEEX_SSH_PORT=22
# Пути внутри контейнера; ~/.ssh хоста уже монтируется в /root/.ssh.
UEEX_SSH_KEY=/root/.ssh/id_ed25519_ueex
# known_hosts используется, только если UEEX_SSH_HOST_KEY_SHA256 пуст.
UEEX_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
# Отпечаток получен пользователем в доверенной SSH-сессии vdska.
UEEX_SSH_HOST_KEY_SHA256=SHA256:YlINK4Ct0aKTvH2SO+W/NB9RduGj6Cw9blqN5u6qz3E
UEEX_SSH_CONNECT_TIMEOUT=10
UEEX_SSH_STARTUP_TIMEOUT=20
# Нужны только в режиме forward; служебные порты Hiddify не подставлять наугад.
UEEX_REMOTE_PROXY_PORT=0
UEEX_REMOTE_PROXY_SCHEME=socks5h

# СПбМТСБ. Пустой список получателей использует RECIPIENTS.
SPIMEX_SUCCESS_RECIPIENTS=
SPIMEX_ERROR_RECIPIENTS=
SPIMEX_URL=https://spimex.com/markets/oil_products/instruments/list/service.php?code=PCX1UGU036F&rand=960&pageId=1e7e0c0&token=___
SPIMEX_LAST_ROWS=30
SPIMEX_OUTPUT_DIR=output/spimex
SPIMEX_CSV_FILENAME=spimex_latest.csv
SPIMEX_TIMEZONE=Europe/Moscow
# auto: UTF-8/UTF-16 BOM/Windows-1251. При необходимости задайте cp1251.
SPIMEX_SOURCE_ENCODING=auto
# auto, tab или символ-разделитель. service.php распознаётся без заголовка.
SPIMEX_SOURCE_DELIMITER=auto
# Пусто — найти дату автоматически. Для service.php столбец даты называется date.
SPIMEX_DATE_COLUMN=
# Пусто — прямой доступ. Здесь можно указать HTTP/SOCKS-прокси.
SPIMEX_PROXY_URL=
SPIMEX_CONNECT_TIMEOUT=10
SPIMEX_READ_TIMEOUT=60
SPIMEX_HTTP_ATTEMPTS=3

# Среднесуточная температура Цхинвала. Отдельное ежедневное письмо.
TSKHINVAL_SUCCESS_RECIPIENTS=
TSKHINVAL_ERROR_RECIPIENTS=
TSKHINVAL_OUTPUT_DIR=output/tskhinval
TSKHINVAL_CSV_FILENAME=temperature_tskhinval.csv
TSKHINVAL_TIMEZONE=Europe/Moscow
# Завершённые сутки от D-15 по D-1.
TSKHINVAL_PAST_DAYS=15
# Горизонт по прежнему соглашению: сегодня и следующие 7 суток (8 строк).
TSKHINVAL_FORECAST_DAYS_AHEAD=7
# false — только завтра … D+7, всего 7 строк.
TSKHINVAL_INCLUDE_TODAY=true
TSKHINVAL_REGION_NAME=Цхинвал
TSKHINVAL_PARENT_NAME=Южная Осетия
TSKHINVAL_LATITUDE=42.22764
TSKHINVAL_LONGITUDE=43.96861
TSKHINVAL_ELEVATION_METRES=874
TSKHINVAL_MODEL=ecmwf_ifs
TSKHINVAL_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
TSKHINVAL_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# При наличии ключа стандартные URL автоматически переключаются на customer-*.
TSKHINVAL_API_KEY=
# Open-Meteo / Цхинвал: сначала напрямую, затем резервный маршрут.
# direct = только напрямую; proxy или vpn = сразу резервный маршрут.
TSKHINVAL_NETWORK_MODE=auto
# Число сетевых попыток напрямую до переключения. Прокси использует HTTP_ATTEMPTS.
TSKHINVAL_DIRECT_ATTEMPTS=1
TSKHINVAL_HTTP_ATTEMPTS=3
TSKHINVAL_CONNECT_TIMEOUT=10
TSKHINVAL_READ_TIMEOUT=60

# Если задан явный HTTP/SOCKS-прокси, он используется как резервный.
# Если пусто, скрипт сам создаёт SSH-туннель; запущенный Hiddify не требуется.
TSKHINVAL_PROXY_URL=
TSKHINVAL_TUNNEL_MODE=dynamic
# Пустые SSH-поля наследуют ваши действующие одноимённые UEEX_*.
TSKHINVAL_SSH_HOST=
TSKHINVAL_SSH_USER=
TSKHINVAL_SSH_PORT=
# На ноутбуке: /home/alexander/.ssh/<закрытый ключ>; в Docker: /root/.ssh/<ключ>.
TSKHINVAL_SSH_KEY=
TSKHINVAL_SSH_KNOWN_HOSTS=
TSKHINVAL_SSH_HOST_KEY_SHA256=
TSKHINVAL_SSH_CONNECT_TIMEOUT=
TSKHINVAL_SSH_STARTUP_TIMEOUT=
# Порт нужен только для forward; dynamic использует собственный SOCKS5 через SSH.
TSKHINVAL_REMOTE_PROXY_PORT=0
TSKHINVAL_REMOTE_PROXY_SCHEME=socks5h

# Eurostat — месячный газовый баланс NRG_CB_GASM.
# Задача включается и отключается только в main.py, ENABLED_PROCESSES.
EUROSTAT_RUN_DAY=25
EUROSTAT_TIMEZONE=Europe/Moscow
# Отметка успеха хранится в уже подключённом постоянном каталоге state.
EUROSTAT_STATE_FILE=state/eurostat_monthly.json
EUROSTAT_OUTPUT_DIR=output/eurostat
EUROSTAT_CSV_FILENAME=eurostat_gas_balance.csv
# Начало окна — текущий месяц минус указанное число месяцев.
EUROSTAT_LOOKBACK_MONTHS=24
# MIO_M3 — млн м³, TJ_GCV — ТДж по высшей теплоте сгорания.
EUROSTAT_UNIT=MIO_M3
EUROSTAT_URL=https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/nrg_cb_gasm
# Пусто — общий RECIPIENTS / ADMIN_RECIPIENTS.
EUROSTAT_SUCCESS_RECIPIENTS=
EUROSTAT_ERROR_RECIPIENTS=
# Пусто — прямой доступ. Прокси задаётся независимо от УЭБ.
EUROSTAT_PROXY_URL=
EUROSTAT_CONNECT_TIMEOUT=10
EUROSTAT_READ_TIMEOUT=120
EUROSTAT_HTTP_ATTEMPTS=3
