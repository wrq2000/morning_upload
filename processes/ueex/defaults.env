# Период и часовой пояс. Пустой END_DATE = текущая дата по Москве.
START_DATE=2026-10-15
END_DATE=
TIMEZONE=Europe/Moscow

# Источники УЭБ.
CALENDAR_URL=https://www.ueex.com.ua/auctions-calendar/prirodnij-gaz/
PUBLIC_BASE=https://bets.ueex.com.ua/public/
RESULTS_PAGE=PositionList.aspx
API_HANDLER=Handler/Action
RESULTS_COMMAND=jResults
AUCTION_NUMBER_PATTERN=GASEDP-\d{6}-\d{4}-\d+

# Прокси Hiddify. socks5h передаёт разрешение DNS прокси-серверу.
# Если входящий порт настроен только как HTTP, поменяйте схему на http://.
PROXY_ENABLED=true
PROXY_URL=socks5h://127.0.0.1:12334

# HTTP: таймауты, число попыток, паузы, заголовки.
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=45
HTTP_ATTEMPTS=5
# Пауза отсчитывается ПОСЛЕ полного получения ответа, а не от начала запроса.
HTTP_REQUEST_PAUSE=3
HTTP_RETRY_BACKOFF=10
HTTP_RETRY_MAX_DELAY=120
# Отдельное ожидание при HTTP 429: 30, 60, 120, 240, 300 секунд.
# Если Retry-After требует больше — его значение не сокращается.
HTTP_RATE_LIMIT_BACKOFF=30
HTTP_RATE_LIMIT_MAX_DELAY=300
HTTP_WAIT_LOG_INTERVAL=30
HTTP_COOLDOWN_FILE=output/ueex/ueex_http_cooldown.json
HTTP_RETRY_STATUSES=[408,429,500,502,503,504]
HTTP_VERIFY_TLS=true
HTTP_HEADERS={"User-Agent":"Mozilla/5.0","Accept":"application/json,text/html;q=0.9,*/*;q=0.8","Accept-Encoding":"identity"}
# 0 = без отдельного общего таймаута DataGateway; HTTP-таймауты действуют.
GATEWAY_TIMEOUT=0

# Файлы и формат. Относительные пути отсчитываются от корня проекта.
OUTPUT_DIR=output/ueex
CSV_FILE=ueex_gas_export.csv
STATE_FILE=ueex_gas_export_state.json
LOCK_FILE=ueex_gas_export.lock
CHECKPOINT_FILE=ueex_gas_export_checkpoint.json
RESUME_ENABLED=true
RESUME_MAX_AGE_SECONDS=21600
CSV_DELIMITER=;
CSV_DECIMAL_SEPARATOR=,
CSV_ENCODING=utf-8-sig

# Каждый запуск: текущее число и RECHECK_DAYS - 1 предыдущих дней.
# Старые результаты берутся из сохранённого состояния без запросов к сайту.
RECHECK_DAYS=14

# Логирование: цветная консоль и обычный файл с ротацией, время МСК.
LOG_LEVEL=INFO
LOG_FILE=output/logs/ueex_gas_export.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s:%(lineno)d | %(message)s"
LOG_DATE_FORMAT="%Y-%m-%d %H:%M:%S"
LOG_CONSOLE_COLOR=true
LOG_COLORS={"DEBUG":"cyan","INFO":"green","WARNING":"yellow","ERROR":"red","CRITICAL":"bold_red"}


# Ошибка Message в HTTP 200: отдельные повторы для одного аукциона.
API_ERROR_ATTEMPTS=2
API_ERROR_BACKOFF=5
